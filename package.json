{
  "name": "mattpocock-skills-agy-plugin",
  "version": "1.0.0",
  "description": "Converter for Matt Pocock skills (Claude plugin format) into Antigravity (AGY) plugin format",
  "main": "dist/index.js",
  "bin": {
    "mattpocock-skills-agy-plugin": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "convert": "tsx src/index.ts convert",
